{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["src/features/cashier/utils/*"],
      "@components/*": ["src/features/cashier/components/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
