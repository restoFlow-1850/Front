# RestoFlow Frontend - Environment Variables Example
# Local development uses same-origin /api requests and Vite proxies them to this
# deployed backend, avoiding CORS errors.
VITE_API_PROXY_TARGET=https://backend-production-109c0.up.railway.app

# To use a local backend instead:
# VITE_API_PROXY_TARGET=http://localhost:3000

# For a static production deployment without a reverse proxy, set these to an
# API origin that explicitly allows the deployed frontend origin through CORS.
# VITE_API_URL=https://backend-production-109c0.up.railway.app/api
# VITE_SOCKET_URL=https://backend-production-109c0.up.railway.app
