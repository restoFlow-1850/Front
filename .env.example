# RestoFlow Frontend - Environment Variables Example
# Local development uses same-origin /api requests and Vite proxies them to this
# deployed backend, avoiding CORS errors.
VITE_API_PROXY_TARGET=https://backend-production-109c0.up.railway.app

# To use a local backend instead:
# VITE_API_PROXY_TARGET=http://localhost:3000

# AI chat endpoint used by /ai-chat. A relative path is appended to VITE_API_URL
# (/api + /ai/chat); an absolute URL must point to the full backend endpoint.
# No API keys belong here — the backend keeps ANTHROPIC_API_KEY server-side.
# VITE_AI_CHAT_URL=/ai/chat

# Used in production builds (and in dev only as a relative path, e.g. /api).
# For a static deployment without a reverse proxy, use an API origin that
# explicitly allows the deployed frontend origin through CORS.
# VITE_API_URL=https://backend-production-109c0.up.railway.app/api
# VITE_SOCKET_URL=https://backend-production-109c0.up.railway.app
